rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users (credenciais — apenas servidor) ──────────────────
    // Passwords hash guardados aqui. Acesso APENAS via REST API
    // server-side. Bloqueado para o client SDK.
    match /users/{userId} {
      allow read, write: if false;
    }

    // ─── App Users (colaboradores) ──────────────────────────────
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // ─── Obras ──────────────────────────────────────────────────
    match /obras/{obraId} {
      allow read, write: if true;
    }

    // ─── Checklists ─────────────────────────────────────────────
    match /checklists/{checklistId} {
      allow read, write: if true;
    }

    // ─── Histórico de Atividades ────────────────────────────────
    match /activity_log/{logId} {
      allow read, write: if true;
    }

    // ─── Teste de conexão ───────────────────────────────────────
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // ─── Catch-all: negar tudo o resto ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
