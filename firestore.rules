rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users (credenciais — apenas servidor via REST API com API key) ──
    // A coleção "users" contém password_hash — acesso apenas via
    // Firestore REST API server-side. O client SDK não acede diretamente.
    match /users/{userId} {
      allow read, write: if false;
    }

    // ─── App Users (colaboradores registados pela app) ───────────────
    match /app_users/{userId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── Obras ───────────────────────────────────────────────────────
    // Qualquer utilizador autenticado pode ler.
    // Apenas utilizadores autenticados podem criar/editar/apagar.
    // Em produção sem Firebase Auth ativo, permitir operações básicas.
    match /obras/{obraId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── Checklists ──────────────────────────────────────────────
    match /checklists/{checklistId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── Histórico de Atividades ─────────────────────────────────
    match /activity_log/{logId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      allow update: if false;
    }

    // ─── Catch-all: negar tudo o resto ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
